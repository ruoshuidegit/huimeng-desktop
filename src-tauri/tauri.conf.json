{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "huimeng-desktop",
  "version": "0.3.0",
  "identifier": "com.ruoshui.huimeng",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "windows": {
        "installMode": "quiet"
      },
      "endpoints": [
        "https://github.com/ruoshuidegit/huimeng-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDQTE1OTM1QjZEOEI5RkIKUldUN3VkaTJOVm1obk5TTmpTdVlQbXJVd1JRUDdBRjFPcnJoRjc1MGdYbkRPeFZyWERQUGVCa0oK"
    }
  },
  "bundle": {
    "active": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "infoplist/en.lproj/InfoPlist.strings",
        "Resources/zh-Hans.lproj/InfoPlist.strings": "infoplist/zh-Hans.lproj/InfoPlist.strings",
        "Resources/zh-Hant.lproj/InfoPlist.strings": "infoplist/zh-Hant.lproj/InfoPlist.strings"
      }
    },
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
